<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash-screen entrance animation: the mark pops in with a slight
  overshoot (scales past full size, then settles back) while un-twisting
  from a small counter-rotation, centered on the mark's own visual middle
  (mark_anim's pivot in ic_splash_mark.xml) rather than the canvas corner.
  Referenced as windowSplashScreenAnimatedIcon in values/styles.xml.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_mark">
    <target android:name="mark_anim">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="500"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="500"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="-12"
                    android:valueTo="0"
                    android:duration="500"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
